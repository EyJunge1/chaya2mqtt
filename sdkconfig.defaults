# Dynamic frequency scaling (used by esp_pm_configure in main.cpp).
CONFIG_PM_ENABLE=y
# Keep tickless idle off — web/MQTT must stay responsive.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n

# Task Watchdog (Arduino-ESP32 / ESP-IDF defaults made explicit — STAB-14).
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
