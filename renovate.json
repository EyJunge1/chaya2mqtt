{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 3,
  "rangeStrategy": "pin",
  "customDatasources": {
    "platformio-library": {
      "defaultRegistryUrlTemplate": "https://api.registry.platformio.org/v3/packages/{{#if (containsString packageName '/')}}{{{replace '/.*' '' packageName}}}{{else}}platformio{{/if}}/library/{{{replace '.*/' '' packageName}}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map($.versions, function($v) { {\"version\": $v.name, \"releaseTimestamp\": $v.released_at} })], \"homepage\": $.repository_url}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned PioArduino platform release",
      "managerFilePatterns": [
        "/^platformio\\.ini$/"
      ],
      "matchStrings": [
        "platform\\s*=\\s*https://github\\.com/pioarduino/platform-espressif32/releases/download/(?<currentValue>[^/]+)/platform-espressif32\\.zip"
      ],
      "depNameTemplate": "pioarduino/platform-espressif32",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose",
      "autoReplaceStringTemplate": "platform = https://github.com/pioarduino/platform-espressif32/releases/download/{{{newValue}}}/platform-espressif32.zip"
    },
    {
      "customType": "regex",
      "description": "Update pinned PlatformIO libraries",
      "managerFilePatterns": [
        "/^platformio\\.ini$/"
      ],
      "matchStrings": [
        "\\s+(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_. -]+)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "custom.platformio-library",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group PlatformIO library updates",
      "matchDatasources": [
        "custom.platformio-library"
      ],
      "groupName": "PlatformIO libraries"
    }
  ]
}
