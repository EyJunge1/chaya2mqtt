root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.c,*.cc,*.cpp,*.h,*.hpp}]
indent_style = space
indent_size = 4

[{*.css,*.html,*.js,*.json,*.jsx,*.ts,*.tsx,*.yaml,*.yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
