{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\" \"mock/**/*.ts\" \"e2e/**/*.ts\" \"*.{ts,js,json,html}\" \".prettierrc\" \".oxlintrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,html}\" \"mock/**/*.ts\" \"e2e/**/*.ts\" \"*.{ts,js,json,html}\" \".prettierrc\" \".oxlintrc.json\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
